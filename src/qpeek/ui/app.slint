import { AboutSlint, Palette } from "std-widgets.slint";

export global Theme {
    in-out property <bool> is-light: false;
    in-out property <string> active-theme: "obsidian";
    in-out property <string> font-family: "Segoe UI";
    in-out property <length> card-radius: 10px;
    in-out property <length> control-radius: 7px;
    in-out property <length> bar-radius: 3px;
    in-out property <length> bar-height: 6px;
    in-out property <length> border-w: 1px;

    in-out property <color> bg: #0F1117;
    in-out property <color> stub-bg: #141824;
    in-out property <color> notch-bg: #080A0E;
    in-out property <color> perf-dash: #384158;
    in-out property <color> card: #181C26;
    in-out property <color> card-border: #282E3E;
    in-out property <color> hover-bg: #1F2433;
    in-out property <color> badge-bg: #202532;
    in-out property <color> badge-border: #31384B;
    in-out property <color> track: #252B3B;
    in-out property <color> monogram-bg: #23293A;
    in-out property <color> text-primary: #F3F4F6;
    in-out property <color> text-secondary: #D1D5DB;
    in-out property <color> text-muted: #9CA3AF;
    in-out property <color> text-dim: #6B7280;
    in-out property <color> emerald: #10B981;
    out property <color> accent: Theme.emerald;
    in-out property <color> amber: #F59E0B;
    in-out property <color> coral: #EF4444;
    in-out property <color> sky: #38BDF8;
    in-out property <color> active-btn-text: #0F1117;
}

